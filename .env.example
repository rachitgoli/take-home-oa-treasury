# Google AI Studio key used for label text extraction.
# Create one at https://aistudio.google.com/apikey — free tier, no card required.
# Do not attach a billing account to the project: doing so removes its free tier.
GEMINI_API_KEY=

# Optional. Overrides the extraction model. Flash-Lite is the default because
# its free-tier request allowance is far higher than the standard Flash models.
# GEMINI_MODEL=gemini-3.5-flash-lite
